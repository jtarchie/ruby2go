#!/usr/bin/env ruby
# frozen_string_literal: true

# Rewrites the decisions index in docs/design.md: a `number | title | line` table of the
# numbered list under "## Open decisions", between the design-index:start/end markers.
# A decision head is `N. ` at column 0 with N one more than the last (so numbered lists
# inside a decision are skipped); its title is the leading **bold** phrase, else the
# first ~70 characters of its text. Usage: scripts/design-index [--check] [path]
# (--check exits 1 when the index is stale, writing nothing).

check = ARGV.delete("--check")
path = ARGV.first || File.expand_path("../docs/design.md", __dir__)
START = "<!-- design-index:start -->"
STOP = "<!-- design-index:end -->"

lines = File.read(path).lines(chomp: true)
s = lines.index(START) or abort "#{path}: no #{START}"
e = lines.index(STOP) or abort "#{path}: no #{STOP}"
abort "#{path}: markers out of order" unless s < e
stripped = lines[0..s] + lines[e..]

from = stripped.index("## Open decisions") or abort "#{path}: no '## Open decisions'"
rows = []
stripped.each_with_index do |l, i|
  next if i < from
  next unless (m = l.match(/\A(\d+)\. /)) && m[1].to_i == rows.size + 1

  head = ([l] + stripped[i + 1, 3].take_while { |x| !x.empty? }).join(" ").gsub(/\s+/, " ")
  title = head[/\A\d+\. \*\*(.+?)\*\*/, 1] || head.sub(/\A\d+\. /, "")
  title = title.delete("`").gsub("**", "").sub(/[:;,.]?\s*\z/, "")
  title = "#{title[0, 69].rstrip}…" if title.size > 70
  rows << [m[1], title.gsub("|", "\\|"), i + 1]
end
abort "#{path}: no numbered decisions after '## Open decisions'" if rows.empty?

# every decision sits below the block, so its final line is its stripped line plus the block's length
body = ["", "Generated by `scripts/design-index`; rerun it after adding or retitling a decision.", "",
        "| # | Title | Line |", "|--:|-------|-----:|"]
shift = body.size + rows.size + 1 # + the blank line before the end marker
body.concat(rows.map { |n, t, l| "| #{n} | #{t} | #{l + shift} |" })
body << ""

out = (lines[0..s] + body + lines[e..]).join("\n") + "\n"
if check
  exit(out == File.read(path) ? 0 : 1)
end
File.write(path, out)
puts "#{path}: #{rows.size} decisions"
