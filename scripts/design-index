#!/usr/bin/env ruby
# frozen_string_literal: true

# Rewrites the decisions index in docs/design.md, a `number | title` table of
# docs/decisions/NNN.md, between the design-index:start/end markers. A decision's title
# is the leading **bold** phrase of its text, else its first ~70 characters. Files must
# be numbered 1..N with no gap. Usage: scripts/design-index [--check]
# (--check exits 1 when the index is stale or numbering is broken, writing nothing).

check = ARGV.delete("--check")
root = File.expand_path("../docs", __dir__)
path = File.join(root, "design.md")
START = "<!-- design-index:start -->"
STOP = "<!-- design-index:end -->"

files = Dir[File.join(root, "decisions", "*.md")].sort
nums = files.map { |f| File.basename(f, ".md")[/\A\d{3}\z/]&.to_i or abort "#{f}: not named NNN.md" }
abort "decisions are not numbered 1..#{nums.size} without gaps" unless nums == (1..nums.size).to_a

rows = files.zip(nums).map do |f, n|
  text = File.read(f).lines(chomp: true).drop_while { |l| l.start_with?("# ") || l.empty? }
  text = text.drop_while { |l| l.start_with?("**Rule:**") || l.empty? }
  head = text.take_while { |x| !x.empty? }.first(4).join(" ").gsub(/\s+/, " ")
  title = head[/\A\*\*(.+?)\*\*/, 1] || head
  title = title.delete("`").gsub("**", "").gsub(/\[([^\]]*)\]\([^)]*\)/, "\\1").sub(/[:;,.]?\s*\z/, "")
  title = "#{title[0, 69].rstrip}…" if title.size > 70
  "| #{n} | [#{title.gsub(/[|\[\]]/) { "\\#{$&}" }}](decisions/#{File.basename(f)}) |"
end

lines = File.read(path).lines(chomp: true)
s = lines.index(START) or abort "#{path}: no #{START}"
e = lines.index(STOP) or abort "#{path}: no #{STOP}"
body = ["", "Generated by `scripts/design-index`; rerun it after adding or retitling a decision.", "",
        "| # | Decision |", "|--:|----------|", *rows, ""]
out = (lines[0..s] + body + lines[e..]).join("\n") + "\n"
exit(out == File.read(path) ? 0 : 1) if check
File.write(path, out)
puts "#{path}: #{rows.size} decisions"
