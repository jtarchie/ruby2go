#!/usr/bin/env ruby
# frozen_string_literal: true

# Writes prelude/go/unicode_normalize_tables.go from MRI's own unicode_normalize tables (decision 136), so rb2go normalizes with the Unicode version MRI does.
#
#   scripts/gen-unicode-normalize    # rewrite the file; rerun after a Ruby upgrade

require "unicode_normalize/tables"

ROOT = File.expand_path("..", __dir__)
OUT = File.join(ROOT, "prelude/go/unicode_normalize_tables.go")

hex = ->(s) { s.codepoints.map { |c| c.to_s(16).upcase }.join(" ") }
table = ->(h) { h.sort_by { |k, _| k.codepoints }.map { |k, v| "#{hex[k]}=#{hex[v]}" }.join(";") }
ccc = UnicodeNormalize::CLASS_TABLE.sort_by { |k, _| k.ord }.map { |k, v| "#{k.ord.to_s(16).upcase}=#{v}" }.join(";")

# A string constant compiles far faster than a map literal of thousands of entries; rbNormTables parses it once, on first use.
consts = {
  "rbNormCCCData" => ccc,
  "rbNormDecompData" => table[UnicodeNormalize::DECOMPOSITION_TABLE],
  "rbNormKompatData" => table[UnicodeNormalize::KOMPATIBLE_TABLE],
  "rbNormCompData" => table[UnicodeNormalize::COMPOSITION_TABLE],
}

File.open(OUT, "w") do |f|
  f.puts "//go:build ignore"
  f.puts
  f.puts "// Code generated by scripts/gen-unicode-normalize from MRI's unicode_normalize/tables.rb (Unicode #{Encoding::UNICODE_VERSION}). DO NOT EDIT."
  f.puts "package prelude"
  consts.each do |name, data|
    f.puts
    f.puts "const #{name} = #{data.dump}"
  end
end
puts "#{OUT}: #{File.size(OUT)} bytes"
