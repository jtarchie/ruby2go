     @resources.freeze
diff --git a/Library/Homebrew/unpack_strategy.rb b/Library/Homebrew/unpack_strategy.rb
index b82e801a75..0da4fcdf58 100644
--- a/Library/Homebrew/unpack_strategy.rb
+++ b/Library/Homebrew/unpack_strategy.rb
@@ -48,6 +48,9 @@ module UnpackStrategy
 
   mixes_in_class_methods(ClassMethods)
 
+  sig { returns(T::Array[String]) }
+  def self.extensions = []
+
   sig { returns(T::Array[UnpackStrategyType]) }
   def self.strategies
     @strategies ||= T.let([
