     ObserverPathnameExtension.reset_counts!
 
-    dirs = []
+    dirs = T.let([], T::Array[Pathname])
 
     keg_directories = self.class.keg_link_directories.map { |d| path/d }.select(&:exist?)
 
     keg_directories.each do |dir|
       dir.find do |src|
-        dst = HOMEBREW_PREFIX + src.relative_path_from(path)
-        dst.extend(ObserverPathnameExtension)
+        dst = ObservedPathname.new(HOMEBREW_PREFIX + src.relative_path_from(path))
 
         dirs << dst if dst.directory? && !dst.symlink?
 
@@ -913,8 +912,7 @@ class Keg
       next if src == root
 
       relative_src = src.relative_path_from(path)
-      dst = HOMEBREW_PREFIX + relative_src
-      dst.extend ObserverPathnameExtension
+      dst = ObservedPathname.new(HOMEBREW_PREFIX + relative_src)
 
       if src.symlink? || src.file?
         Find.prune if File.basename(src) == ".DS_Store"
