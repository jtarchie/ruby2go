+        (allow default) ; allow everything else
+        ERB
           rules:                  profile.rules.map { |rule| seatbelt_rule(rule) },
           network_access_allowed: profile.rules.none? do |rule|
             !rule.allow && rule.operation == "network*" && rule.filter.nil?
