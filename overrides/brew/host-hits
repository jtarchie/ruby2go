#!/bin/bash
# host: ./hits for work/homebrew (./host): stubs in work/mac.go that MRI reaches running `brew <args>`.
# usage: ./host-hits info wget   (writes work/mac.go first)
cd "$(dirname "$0")"
export HOMEBREW_NO_AUTO_UPDATE=1
HOMEBREW_RUGAROO_CMD=gen HOMEBREW_RUGAROO_GEM_WARNINGS=1 work/homebrew/bin/brew "$@" > work/mac.go 2> work/mac.go.log || { tail -5 work/mac.go.log; exit 1; }
HOMEBREW_RUGAROO_MRI=1 HOMEBREW_RUGAROO_MRI_REQUIRE="$PWD/tools/calltrace.rb" HOMEBREW_RUGAROO_CALLTRACE_DIR="$PWD/work" work/homebrew/bin/brew "$@" > /dev/null 2>&1
python3 tools/hits.py work/mac.go work | tee work/hits-mac.txt
