#!/bin/bash
# host (macOS): uninstall wget, then `brew install wget` through work/mac-bin (./macgen build); output equals work/mac-install-mri.txt
cd "$(dirname "$0")" || exit 1
export HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ANALYTICS=1
/opt/homebrew/bin/brew uninstall --ignore-dependencies wget > /dev/null 2>&1
HOMEBREW_RUGAROO_BIN=$PWD/work/mac-bin HOMEBREW_RUGAROO_BACKTRACE=1 ${MACRUN_ARGS:-} /opt/homebrew/bin/brew-rugaroo install wget > work/mac-install-rb.txt 2>&1
echo "exit $?" >> work/mac-install-rb.txt
cat work/mac-install-rb.txt
