#!/bin/bash
# host: the work list for `brew <args>`: stubs in work/brew.go that MRI reaches running it (patched, spawn mode).
# usage: ./hits info --json=v2 wget   (run ./gen first)
cd "$(dirname "$0")"
docker run --rm -v "$PWD:/w" rb2go-brew-dev /w/tools/in-container.sh hits "$@"
python3 tools/hits.py work/brew.go work | tee work/hits.txt
