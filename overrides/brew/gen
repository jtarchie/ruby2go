#!/bin/bash
# host: cross-build rugaroo, then in the container trace every targets.txt line and generate work/brew.go (decision 296).
set -e
cd "$(dirname "$0")"; mkdir -p work
[ -f work/go.mod ] || printf 'module work\n\ngo 1.24\n' > work/go.mod # its own module: the repo's ./... skips generated Go
(cd ../.. && GOOS=linux GOARCH=arm64 go build -o overrides/brew/work/rugaroo ./cmd/rugaroo)
docker run --rm -m 10g -e TARGETS -e RUGAROO_GEM_WARNINGS -e RUGAROO_UNTYPED_WHY -e RUGAROO_GOPOISON_DUMP -v "$PWD:/w" rugaroo-brew-dev \
  timeout 1800 /w/tools/in-container.sh gen
