# The kramdown gem ships no signatures; this is what an example's `rbs validate` needs (rb2go compiles the gem itself from a traced run).
module Kramdown
  class Document
    def initialize: (String source, ?Hash[Symbol, untyped] options) -> void
    def warnings: () -> Array[String]
    def to_html: () -> String
    def to_kramdown: () -> String
  end
end
