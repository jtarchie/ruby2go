# The rackup gem ships no signatures; this is what `rbs validate` needs of the gem rb2go compiles (decision 176).
module Rackup
  module Handler
    class WEBrick
      def self.run: (untyped app, **untyped options) ?{ (untyped server) -> void } -> void
      def self.shutdown: () -> void
    end
  end
end
