-- untyped_comparable_calls.rb --
# warning: main.rb:7: dynamic call: between? on untyped
# warning: main.rb:8: dynamic call: clamp on untyped
# rbs_inline: enabled
#: (untyped) -> untyped
def ident(v) = v
v = ident(5)
puts v.between?(1, 10)
puts v.clamp(1, 3)
