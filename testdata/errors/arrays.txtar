pairs << [2, 3]
-- block_returns_non_bool.rb --
# error: main.rb:3:
nums = [1, 2] #: Array[Integer]
puts nums.select { |n| n.to_s }.inspect
-- block_on_untyped.rb --
# error: main.rb:3: blocks on untyped receivers are not supported
u = [1] #: untyped
u.each { |x| puts x }
-- block_on_optional_untyped.rb --
# skip: optCall drops the block on an untyped? receiver: compiles with warnings, then NoMethodError at run time (decision 32: blocks cannot cross a dynamic call)
# error: main.rb:4:
u = [[1]] #: Array[untyped]
u[0].each { |x| puts x }
-- super_to_block_method.rb --
# error: main.rb:11: super to a block-taking method is not supported
class A
  #: () { (Integer) -> void } -> void
  def each
    yield 1
  end
end

class B < A
  def each
    super
  end
end
-- break_in_rescuing_yield.rb --
# error: main.rb:14: break inside a non-iterator block is not supported
#: (Array[Integer]) { (Integer) -> void } -> void
def safe_each(nums)
  nums.each do |n|
    begin
      yield n
    rescue ZeroDivisionError
      puts "r"
    end
  end
end

safe_each([1, 2]) do |n|
  break if n > 1
  puts n
end
