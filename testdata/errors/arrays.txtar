puts nums.flat_map { |n| n > 0 ? [n] : [] }.inspect
-- element_possibly_nil.rb --
# error: main.rb:3: possibly-nil Integer? where Integer is expected; check it first
nums = [1, 2] #: Array[Integer]
puts 1 + nums[0]
-- element_method_warns.rb --
# warning: main.rb:3: succ called on possibly-nil Integer (raises NoMethodError on nil)
nums = [1, 2] #: Array[Integer]
puts nums[0].succ
-- empty_literal_is_untyped.rb --
# warning: main.rb:5: dynamic call: succ on untyped
