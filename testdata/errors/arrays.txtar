-- subclass_array.rb --
# skip: `class Stack < Array` compiles, but the generated Stack code uses the generic Array without type args (undefined: E), so go build fails; want a compile error
# error: main.rb:3:
class Stack < Array
  #: () -> Integer
  def top2 = 2
end
puts Stack.new.top2
