a, b, c = pair
puts a, b, c
-- destructure_integer.rb --
# error: main.rb:2: cannot destructure Integer
a, b = 5
puts a, b
-- tuple_four_elements.rb --
# error: main.rb:3: only 2- and 3-tuples are supported
#: () -> [Integer, Integer, Integer, Integer]
