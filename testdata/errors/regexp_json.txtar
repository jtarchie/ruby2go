Compile errors and warnings for Regexp, MatchData and JSON (docs/design.md decisions 24, 25).
-- lookahead.rb --
# error: main.rb:3: regexp /a(?=b)/ is not supported
# error: invalid or unsupported Perl syntax: `(?=`
puts "ab".match?(/a(?=b)/)
-- negative_lookahead.rb --
# error: main.rb:3: regexp /a(?!b)/ is not supported
# error: `(?!`
puts "ab".match?(/a(?!b)/)
-- lookbehind.rb --
# error: main.rb:3: regexp /(?<=a)b/ is not supported
# error: `(?<=a)b`
puts "ab".match?(/(?<=a)b/)
-- negative_lookbehind.rb --
# error: main.rb:3: regexp /(?<!a)b/ is not supported
# error: `(?<!a)b`
puts "ab".match?(/(?<!a)b/)
-- backreference.rb --
# error: main.rb:3: regexp /(a)\1/ is not supported
# error: invalid escape sequence: `\1`
puts "aa".match?(/(a)\1/)
-- named_backreference.rb --
# error: main.rb:3: regexp /(?<x>a)\k<x>/ is not supported
# error: invalid escape sequence: `\k`
puts "aa".match?(/(?<x>a)\k<x>/)
-- upper_z.rb --
# error: main.rb:2: regexp /b\Z/ is not supported: \Z is not supported by RE2; use \z
puts "ab".match?(/b\Z/)
-- extended_interpolated.rb --
# error: main.rb:3: interpolated extended (/x) regexps are not supported
x = "a"
puts "ab".match?(/#{x} b/x)
-- g_anchor.rb --
# error: main.rb:2: regexp /\Ga/ is not supported: \G is not supported by RE2
puts "ab".match?(/\Ga/)
-- keep.rb --
# error: main.rb:2: regexp /a\Kb/ is not supported: \K is not supported by RE2
puts "ab".match?(/a\Kb/)
-- linebreak.rb --
# error: main.rb:2: regexp /\R/ is not supported: \R is not supported by RE2
puts "a\nb".match?(/\R/)
-- grapheme.rb --
# error: main.rb:2: regexp /\X/ is not supported: \X is not supported by RE2
puts "ab".match?(/\X/)
-- nonhex_in_class.rb --
# error: main.rb:2: regexp /[\H]/ is not supported: \H inside a character class
puts "ab".match?(/[\H]/)
-- possessive.rb --
# error: main.rb:3: regexp /a++/ is not supported
# error: invalid nested repetition operator
puts "aa".match?(/a++/)
-- atomic_group.rb --
# error: main.rb:3: regexp /(?>a)/ is not supported
# error: `(?>`
puts "aa".match?(/(?>a)/)
-- absent_operator.rb --
# error: main.rb:3: regexp /(?~a)/ is not supported
# error: `(?~`
puts "aa".match?(/(?~a)/)
-- interpolated_static_part.rb --
# error: main.rb:3: regexp is not supported: \Z is not supported by RE2; use \z
x = "a"
puts "aa".match?(/#{x}\Z/)
-- interpolation_two_statements.rb --
# error: main.rb:3: interpolation must contain a single expression
x = "a"
puts "aa".match?(/#{x; x}/)
-- interpolation_empty.rb --
# error: main.rb:2: interpolation must contain a single expression
puts "aa".match?(/a#{}/)
-- interpolation_ivar_shorthand.rb --
# error: main.rb:11: unsupported syntax: EmbeddedVariableNode
class Foo
  attr_reader :x #: String

  #: () -> void
  def initialize
    @x = "a"
  end

  #: () -> bool
  def m = /#@x/.match?("a")
end
puts Foo.new.m
-- last_match_gvar.rb --
# error: main.rb:3: global variable $~ is unsupported
"ab" =~ /b/
puts $~.inspect
-- numbered_reference.rb --
# error: main.rb:3: unsupported syntax: NumberedReferenceReadNode
"ab" =~ /(b)/
puts $1.inspect
-- back_reference.rb --
# error: main.rb:3: unsupported syntax: BackReferenceReadNode
"ab" =~ /b/
puts $&.inspect
-- nil_subject.rb --
# error: main.rb:2: nil where String is expected
puts (/a/ =~ nil).inspect
-- match_nil_subject.rb --
# error: main.rb:2: nil where String is expected
puts(/a/.match(nil).inspect)
-- optional_group_as_string.rb --
# error: main.rb:4: possibly-nil String? where String is expected
m = "ab".match(/(a)/)
if m
  puts "x" + m[1]
end
-- optional_group_as_argument.rb --
# error: main.rb:5: possibly-nil String? where String is expected
#: (String) -> String
def up(s) = s.upcase
m = "ab".match(/(a)/)
puts up(m[1]) if m
-- string_match_arity.rb --
# error: main.rb:2: String#match: wrong number of arguments (given 2, expected 1)
puts "abc".match(/b/, 1).inspect
-- regexp_match_arity.rb --
# error: main.rb:2: Regexp#match: wrong number of arguments (given 2, expected 1)
puts(/b/.match("abc", 1).inspect)
-- matchdata_index_arity.rb --
# error: main.rb:3: MatchData#[]: wrong number of arguments (given 2, expected 1)
m = /(b)/.match("abc")
puts m[0, 2].inspect if m
-- match_block.rb --
# error: main.rb:2: match does not take a block
puts(/b/.match("abc") { |m| m }.inspect)
-- warn_index_nil_match.rb --
# warning: main.rb:3: [] called on possibly-nil MatchData (raises NoMethodError on nil)
m = "ab".match(/a/)
puts m[0].inspect
-- warn_chain_nil_match.rb --
# warning: main.rb:3: pre_match called on possibly-nil MatchData (raises NoMethodError on nil)
# warning: main.rb:4: captures called on possibly-nil MatchData
puts "ab".match(/(a)/).pre_match
puts "ab".match(/(a)/).captures.size
-- warn_eqtilde_arithmetic.rb --
# warning: main.rb:2: + called on possibly-nil Integer (raises NoMethodError on nil)
puts ("ab" =~ /b/) + 1
-- warn_nil_group_method.rb --
# warning: main.rb:3: upcase called on possibly-nil String
m = /(z)?c/.match("abc")
puts m[1].upcase if m
-- json_generate_block.rb --
# error: main.rb:3: generate does not take a block
require "json"
puts JSON.generate([1]) { |x| x }
-- subexp_call.rb --
# error: main.rb:3: regexp /(?<n>a)\g<n>/ is not supported
# error: invalid escape sequence: `\g`
puts "aa".match?(/(?<n>a)\g<n>/)
-- inline_extended_flag.rb --
# error: main.rb:3: regexp /(?x) a b / is not supported
# error: `(?x`
puts "ab".match?(/(?x) a b /)
-- interpolated_lookahead.rb --
# error: main.rb:4:
# error: not supported
x = "a"
puts "ab".match?(/#{x}(?=b)/)
-- interpolated_backreference.rb --
# error: main.rb:4:
# error: not supported
x = "a"
puts "aa".match?(/(#{x})\1/)
-- json_generate_arity_ruby_name.rb --
# error: main.rb:3: JSON.generate: wrong number of arguments (given 0, expected 2)
require "json"
puts JSON.generate
-- regexp_new_arity.rb --
# error: main.rb:2: Regexp.new: wrong number of arguments (given 3
puts Regexp.new("a", "i", 1).inspect
-- symbol_eqtilde_undefined.rb --
# error: main.rb:2: undefined method =~ for Symbol
puts (:abc =~ /b/).inspect
-- string_where_regexp_expected.rb --
# error: main.rb:2:
puts "abc".match?("b")
-- csv_unknown_option.rb --
# error: main.rb:3: CSV option header_converters: is not supported
require "csv"
p CSV.parse("a\n1", headers: true, header_converters: :symbol)
-- csv_unknown_converter.rb --
# error: main.rb:3: CSV converters: takes :numeric, :integer or :float
require "csv"
p CSV.parse("a\n1", converters: :date)
-- csv_headers_not_literal.rb --
# error: main.rb:4: CSV headers: must be a literal true or false
require "csv"
want = true
p CSV.parse("a\n1", headers: want)
