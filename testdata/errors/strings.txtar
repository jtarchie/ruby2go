String, Symbol, literal/interpolation and Kernel output compile errors and warnings.

-- xstring_top_level.rb --
# error: main.rb:3: top-level %x{} is only allowed in the prelude
# rbs_inline: enabled
%x{ fmt.Println("hi") }
-- xstring_user_method_body.rb --
# error: main.rb:4: String where Integer is expected
# rbs_inline: enabled
#: () -> Integer
def hi = %x{ 1 }
puts hi
-- interp_empty.rb --
# error: main.rb:3: interpolation must contain a single expression
# rbs_inline: enabled
puts "a#{}b"
-- interp_multi.rb --
# error: main.rb:4: interpolation must contain a single expression
# rbs_inline: enabled
x = 1
puts "a#{x; x + 1}b"
-- interp_heredoc_multi.rb --
# error: main.rb:5: interpolation must contain a single expression
# rbs_inline: enabled
x = 1
s = <<~EOS
  #{x; 2}
EOS
puts s
-- interp_ivar_shorthand.rb --
# error: main.rb:10: unsupported syntax: EmbeddedVariableNode
# rbs_inline: enabled
class A
  #: () -> void
  def initialize
    @n = 1
  end

  #: () -> String
  def show = "n=#@n"
end
puts A.new.show
-- interp_gvar_shorthand.rb --
# error: main.rb:3: unsupported syntax: EmbeddedVariableNode
# rbs_inline: enabled
puts "prog=#$0"
-- upcase_bang.rb --
# error: main.rb:4: undefined method upcase! for String
# rbs_inline: enabled
s = "abc"
s.upcase!
puts s
-- shovel.rb --
# error: main.rb:5: undefined method << for String: Strings are immutable in rugaroo, and `s` is stored or passed on line 4 before its last append (decision 382)
# rbs_inline: enabled
s = +"abc"
t = s
s << "d"
puts t
-- shovel_param.rb --
# error: main.rb:3: undefined method << for String: Strings are immutable in rugaroo, and the value of `s <<` (the String itself) is stored or passed on line 3, while the caller's String it appends to is still in use (decision 405)
# rbs_inline: enabled
def grow(s) = s << "xyz"
s = +"abc"
grow(s)
puts s
-- shovel_passed.rb --
# error: `s` is passed to keep on line 8 before its last append
# rbs_inline: enabled
$kept = [] #: Array[String]
#: (String) -> void
def keep(x) = $kept << x
s = +"a"
3.times do
  keep(s)
  s << "b"
end
p $kept
-- shovel_loop_store.rb --
# error: `s` is passed to << on line 7 before its last append
# rbs_inline: enabled
rows = [] #: Array[String]
s = +""
%w[a b].each do |w|
  s << w
  rows << s
end
p rows
-- shovel_lambda.rb --
# error: `s` is appended to inside a block that may run after its call returns
# rbs_inline: enabled
s = +"a"
add = -> { s << "b" }
add.call
puts s
-- shovel_thread.rb --
# error: `s` is captured by a block that may run after its call returns on line 4 before its last append
# rbs_inline: enabled
s = +"a"
t = Thread.new { puts s }
s << "b"
t.join
-- shovel_retry.rb --
# error: `s` is passed to keep on line 10 before its last append
# rbs_inline: enabled
#: (String) -> void
def keep(x) = puts(x)
s = +"a"
begin
  s << "b"
  raise "again" if s.size < 3
rescue RuntimeError
  keep(s)
  retry
end
-- shovel_not_fresh.rb --
# error: `s` is assigned a String that something else may hold (line 3)
# rbs_inline: enabled
s = ARGV.first || +"x"
s << "y"
puts s
-- shovel_freeze.rb --
# error: `s.freeze` may keep, return or change the String on line 4 before its last append
# rbs_inline: enabled
s = +"a"
s.freeze
s << "b"
puts s
-- shovel_value.rb --
# error: the value of `s <<` (the String itself) is stored or passed on line 4 before its last append
# rbs_inline: enabled
s = +"a"
t = (s << "b")
s << "c"
puts t
-- setbyte_shared.rb --
# error: main.rb:5: undefined method setbyte for String: Strings are immutable in rugaroo, and `s.[]` may share the String's bytes on line 4 before its last change (decision 395)
# rbs_inline: enabled
s = +"abc"
t = s[0, 2]
s.setbyte(0, 65)
puts t
-- setbyte_interpolated.rb --
# error: `s` is interpolated on line 4 before its last change
# rbs_inline: enabled
s = +"abc"
t = "#{s}"
s.setbyte(0, 65)
puts t
-- setbyte_param.rb --
# error: `s` is a parameter, so the caller's String would see the append
# rbs_inline: enabled
#: (String) -> Integer
def poke(s) = s.setbyte(0, 65)
s = +"abc"
poke(s)
puts s
-- setbyte_ivar_outside_initialize.rb --
# error: `@buf` is changed outside initialize (decision 395)
# rbs_inline: enabled
class Buf
  #: () -> void
  def initialize = @buf = +"abc"

  #: () -> Integer
  def poke = @buf.setbyte(0, 65)
end
Buf.new.poke
-- setbyte_ivar_self.rb --
# error: `show` is called on self on line 7 before its last change
# rbs_inline: enabled
class Buf
  #: () -> void
  def initialize
    @buf = +"abc"
    show
    @buf.setbyte(0, 65)
  end

  #: () -> void
  def show = puts(@buf)
end
Buf.new
-- setbyte_ivar_not_fresh.rb --
# error: `@buf` is not first assigned a new String in initialize (line 6)
# rbs_inline: enabled
class Buf
  #: (String) -> void
  def initialize(s)
    @buf = s
    @buf.setbyte(0, 65)
  end
end
Buf.new(+"abc")
-- global_never_assigned.rb --
# error: main.rb:3: global variable $nope is never assigned
# rbs_inline: enabled
puts $nope
-- global_first_write_untyped.rb --
# error: main.rb:3: global variable $words is first assigned here: annotate it
# rbs_inline: enabled
$words = "a b".split
puts $words.size
-- symbol_plus.rb --
# error: main.rb:3: undefined method + for Symbol
# rbs_inline: enabled
puts :a + :b
-- symbol_to_proc.rb --
# error: main.rb:3: undefined method to_proc for Symbol
# rbs_inline: enabled
puts :upcase.to_proc
-- sub_one_arg.rb --
# error: main.rb:3: String#sub: wrong number of arguments (given 1, expected 2)
# rbs_inline: enabled
puts "abc".sub("a")
-- private_puts.rb --
# error: main.rb:3: private method puts called on String
# rbs_inline: enabled
"a".puts("x")
-- private_write.rb --
# error: main.rb:3: private method __write called on String
# rbs_inline: enabled
"a".__write("x")
-- plus_possibly_nil.rb --
# error: main.rb:4: possibly-nil String? where String is expected
# rbs_inline: enabled
t = "xy"[0]
puts "a" + t
-- or_non_nilable.rb --
# error: main.rb:4: `||` on a non-nilable String is always the left side
# rbs_inline: enabled
s = "abc"
puts s || "default"
-- keyword_param.rb --
# error: main.rb:4: def has 1 keyword parameters but its signature has 0
# rbs_inline: enabled
#: (String) -> String
def greet(name:) = "hi #{name}"
puts greet(name: "x")
-- warn_call_on_possibly_nil.rb --
# warning: main.rb:4: upcase called on possibly-nil String (raises NoMethodError on nil)
# rbs_inline: enabled
s = "abc"
puts s[0].upcase
-- warn_interp_on_possibly_nil.rb --
# warning: main.rb:4: size called on possibly-nil String (raises NoMethodError on nil)
# rbs_inline: enabled
s = "abc"
puts "n=#{s[9].size}"
-- warn_dynamic_on_nil.rb --
# warning: main.rb:3: dynamic call: upcase on nil
# rbs_inline: enabled
puts "#{nil.upcase}"
-- warn_string_condition.rb --
# warning: main.rb:4: condition of type String is always true
# rbs_inline: enabled
s = "x"
puts "y" if s
-- string_literal_as_symbol_key.rb --
# error: main.rb:5:
# rbs_inline: enabled

h = { a: 1 } #: Hash[Symbol, Integer]
puts h["a"].inspect
-- string_literal_as_symbol_arg.rb --
# error: main.rb:4:
# rbs_inline: enabled

puts (:a <=> "a").inspect
puts [:a, :b].include?("a").inspect
-- kernel_module_pp.rb --
# error: main.rb:4: private method pp called on singleton(Kernel)
# rbs_inline: enabled
# pp is a private Kernel method but not a module function: MRI's NoMethodError (decision 139)
Kernel.pp "x"
-- object_puts.rb --
# error: main.rb:3: private method puts called on singleton(Object)
# rbs_inline: enabled
Object.puts "x"
-- symbol_encoding.rb --
# error: main.rb:3: undefined method encoding for Symbol
# rbs_inline: enabled
puts :abc.encoding
-- string_shovel.rb --
# error: main.rb:4: undefined method << for String: Strings are immutable in rugaroo
s = +"ab"
a = [s]
s << "c"
puts a
-- string_index_assign.rb --
# error: main.rb:3: undefined method []= for String: Strings are immutable in rugaroo
s = +"ab"
s[0] = "x"
puts s
-- out_param_not_a_local.rb --
# error: main.rb:9: into appends to its `io` parameter, so it takes a local String variable (decision 405)
module V
  #: (String) -> nil
  def self.into(io)
    io << "x"
    nil
  end
end
V.into(+"a")
-- out_param_stored.rb --
# error: main.rb:5: undefined method << for String: Strings are immutable in rugaroo, and `io` is stored or passed on line 6, while the caller's String it appends to is still in use (decision 405)
module V
  #: (String) -> nil
  def self.into(io)
    io << "x"
    @kept = io
    nil
  end
end
s = +""
V.into(s)
-- loaded_features_computed.rb --
# error: main.rb:2: $LOADED_FEATURES takes File.expand_path("file.rb", __dir__) only
$LOADED_FEATURES << "x.rb"
-- concat_no_args_value.rb --
# error: main.rb:4: wrong number of arguments for String#concat
# `s.concat` with no arguments used as a value once sent the append proof into unbounded recursion (a stack overflow in the compiler)
s = +"a"
puts s.concat.equal?(s)
