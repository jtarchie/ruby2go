Parameter types from use (decision 146): what inference cannot type.
-- never_called.rb --
# error: main.rb:2: method lonely has no type for parameter x (`# @rbs x: T` or `#: (...) -> T`), and no call in the program gives it one (decision 146)
def lonely(x) = x
puts 1
-- yields_disagree.rb --
# error: main.rb:5: method each yields 2 values here and 1 before
class Odd
  def each
    yield 1
    yield 1, 2
  end
end
Odd.new.each { |a| p a }
-- rest_never_passed.rb --
# error: method each has no type for parameter arg
class Counter
  def each(*arg)
    arg.size
  end
end
Counter.new.each
-- union_breaks_body.rb --
# error: main.rb:7: String where Integer is expected; parameter x takes its type from the call at main.rb:6 (decision 146): annotate it to take both
# a union for x would break wrap's own body (decision 150): the odd call is reported instead
#: (Integer) -> Integer
def takes_int(n) = n + 1
def wrap(x) = takes_int(x)
p wrap(1)
p wrap("a")
