Compile errors for Ractor isolation (docs/design.md decision 103): what MRI raises at run time, rb2go rejects at compile time.
-- outer_local.rb --
# error: main.rb:4: can not isolate a Proc because it accesses outer variables (x, y).
x = 1
y = 2
Ractor.new { x + y }
-- outer_local_nested_block.rb --
# error: main.rb:3: can not isolate a Proc because it accesses outer variables (total).
total = 0
Ractor.new { [1, 2].each { |v| total += v } }
-- proc_arg.rb --
# error: main.rb:3: allocator undefined for Proc: a Proc cannot be passed to a Ractor
f = ->(x) { x } #: ^(Integer) -> Integer
Ractor.new(f) { |g| g.call(1) }
-- no_block.rb --
# error: main.rb:2: Ractor.new needs a literal block
Ractor.new
-- name_with_positional.rb --
# error: main.rb:2: Ractor.new: name: together with positional arguments is not supported
Ractor.new(1, name: "w") { |x| x }
-- too_many_args.rb --
# error: main.rb:2: Ractor.new takes at most 3 arguments
Ractor.new(1, 2, 3, 4) { |a, b, c, d| a + b + c + d }
