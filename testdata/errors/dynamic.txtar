-- guards_narrow_without_warnings.rb --
# warning: main.rb:25: condition of type String is always true
# rbs_inline: enabled
#: (String) -> Integer
def len(s) = s.size
#: (String?) -> Integer
def a(s)
  return 0 unless s
  len(s)
end
#: (String?) -> Integer
def b(s)
  return 0 if s.nil?
  len(s)
end
#: (String?, String?) -> Integer
def c(s, t)
  s && t ? len(s) + len(t) : 0
end
#: (String?) -> Integer
def d(s)
  s ||= "d"
  len(s)
end
puts a("x"), b(nil), c("a", "b"), d(nil), [1].size.to_s.size
puts 1 if nil.to_s
