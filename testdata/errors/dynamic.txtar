-- narrowing_dropped_by_reassign.rb --
# error: main.rb:11: possibly-nil String? where String is expected
# rbs_inline: enabled
#: (String) -> Integer
def len(s) = s.size
#: (Integer) -> String?
def word(n) = n.positive? ? "w" * n : nil
w = word(1)
if w
  puts len(w)
  w = word(0)
  puts len(w)
end
-- attr_narrowing_dropped_by_writer.rb --
# error: main.rb:17: possibly-nil String? where String is expected
# rbs_inline: enabled
#: (String) -> Integer
def len(s) = s.size
class Node
  attr_accessor :label #: String?

  #: () -> void
  def initialize
    @label = nil
  end

  #: () -> Integer
  def go
    if label
      self.label = nil
      return len(label)
    end
    0
  end
end
puts Node.new.go
