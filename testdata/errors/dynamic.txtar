-- splat_in_computed_send.rb --
# error: main.rb:12:
# rbs_inline: enabled
class Proxy
  #: (untyped) -> void
  def initialize(target)
    @target = target #: untyped
  end

  #: (Symbol, *untyped) -> untyped
  def method_missing(name, *args)
    # a computed send with a splat, the usual proxy idiom
    @target.send(name, *args)
  end
end
puts Proxy.new("abc").center(9)
