def sides(s)
  s.each_side { |x| puts x }
end
sides(Sq.new)
-- go_name_collision_dynamic.rb --
# error: `foo_bar` and `fooBar` both become Go FooBar, so dynamic calls cannot tell them apart
# rbs_inline: enabled
class A
  #: () -> Integer
  def foo_bar = 1
end

class B
  #: () -> Integer
  def fooBar = 2
end

#: (untyped) -> untyped
def ident(v) = v

puts ident(A.new).foo_bar
puts ident(B.new).fooBar
