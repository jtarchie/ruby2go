Compile errors for FFI shapes rugaroo cannot build (docs/design.md decision 375).
-- attach_computed.rb --
# error: main.rb:7: FFI::Library#attach_function needs a literal Array of argument types (decision 375)
require "ffi"
module L
  extend FFI::Library
  ffi_lib FFI::Library::LIBC
  types = [:int]
  attach_function :abs, types, :int
end
-- attach_variadic.rb --
# error: main.rb:6: FFI::Library#attach_function: a varargs C function needs --cgo (purego has no C varargs; decisions 326, 426)
require "ffi"
module L
  extend FFI::Library
  ffi_lib FFI::Library::LIBC
  attach_function :printf, [:string, :varargs], :int
end
-- attach_unknown_type.rb --
# error: main.rb:6: FFI::Library#attach_function: unknown type :widget_t
require "ffi"
module L
  extend FFI::Library
  ffi_lib FFI::Library::LIBC
  attach_function :make, [:int], :widget_t
end
-- attach_by_value.rb --
# error: main.rb:9: FFI::Library#attach_function: a struct by value is not supported (decision 375)
require "ffi"
module L
  extend FFI::Library
  ffi_lib FFI::Library::LIBC
  class Pt < FFI::Struct
    layout :x, :int
  end
  attach_function :take, [Pt.by_value], :void
end
-- attach_many_args.rb --
# error: main.rb:6: FFI::Library#attach_function: more than 8 arguments are stack-passed and need --cgo (decisions 326, 426)
require "ffi"
module L
  extend FFI::Library
  ffi_lib FFI::Library::LIBC
  attach_function :many, [:int, :int, :int, :int, :int, :int, :int, :int, :int], :int
end
-- attach_type_not_symbol.rb --
# error: main.rb:6: FFI::Library#attach_function needs literal Symbol types, read at compile time (decision 375)
require "ffi"
module L
  extend FFI::Library
  ffi_lib FFI::Library::LIBC
  attach_function :abs, ["int"], :int
end
