  #: () { (Integer) -> void } -> void
  def each
    yield 1
  end
end

bag = Bag.new
bag.each
-- value_block_method_without_block.rb --
# error: main.rb:8: first_as requires a block
class Bag
  #: () { (Integer) -> String } -> String
  def first_as = yield(1)
end

bag = Bag.new
puts bag.first_as
-- block_to_blockless_method.rb --
# error: main.rb:7: bark does not take a block
class Dog
  #: () -> String
  def bark = "woof"
end

Dog.new.bark { 1 }
-- ivar_in_class_method_untyped.rb --
# error: main.rb:4: instance variable @count has no known type
class Registry
  #: () -> Integer
  def self.count = @count
end
-- initialize_called_with_receiver.rb --
# skip: calling initialize with an explicit receiver compiles and runs it; initialize is always private in MRI (NoMethodError)
# error: main.rb:10: private method initialize called on Vault
class Vault
  #: () -> void
  def initialize
    @n = 1
  end
end

v = Vault.new
v.initialize
-- top_level_def_with_receiver.rb --
# error: main.rb:8: undefined method helper for Vault
#: (Integer) -> String
def helper(n) = n.to_s

class Vault
end

Vault.new.helper(1)
-- warn_optional_attr_call.rb --
# warning: main.rb:11: upcase called on possibly-nil String
class Profile
  attr_accessor :nick #: String?

  #: () -> void
  def initialize
    @nick = nil
  end
end

puts Profile.new.nick.upcase
